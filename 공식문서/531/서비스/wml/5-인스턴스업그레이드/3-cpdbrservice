                - secret
              labelSelector: "icpdsupport/addOnId in (scheduling),icpdsupport/ignore-on-nd-backup notin (true)"
              includeClusterResources: true
              name: cpd-scheduler-resources
              type: resource
            - backupRef: cpd-scheduler-helm-secrets
              includedResourceTypes:
                - secrets
              name: cpd-scheduler-scheduling-helm-secrets
              type: resource
            - backupRef: cpd-scheduler-resources
              includeClusterResources: true
