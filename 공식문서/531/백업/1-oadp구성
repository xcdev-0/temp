    If your deployment of IBM Software Hub is version 5.3.1 to 5.3.1 patch 3, then you must run the following script. Use the following arguments when running the script to override the defaults.
    Arguments
    	
    Description
    -image-namespace	/cpopen/cpd is the default. Change this if your private registry uses a different namespace structure.
    --image-prefix	icr.io is the default. Change this if you use a private registry hostname. For example, you have an airgapped environment.
    --patch-version	0 is the default. Change this to match the patch that you applied.
        0 for 5.3.1
        1 for 5.3.1 Patch 1
        2 for 5.3.1 Patch 2
        3 for 5.3.1 Patch 3

    #!/bin/bash
    set +e

    # Default values
    DEFAULT_IMAGE_PREFIX="icr.io"
    DEFAULT_IMAGE_NAMESPACE="/cpopen/cpd"
    DEFAULT_PATCH_VERSION="0"

    # Parse command line arguments
    while [[ $# -gt 0 ]]; do
      case $1 in
        --image-prefix)
          IMAGE_PREFIX="$2"
          shift 2
          ;;
        --image-namespace)
          IMAGE_NAMESPACE="$2"
          shift 2
          ;;
        --patch-version)
          PATCH_VERSION="$2"
          shift 2
          ;;
        *)
          echo "Unknown option: $1"
          echo "Usage: $0 [--image-prefix <prefix>] [--image-namespace <namespace>] [--patch-version <version>]"
          exit 1
          ;;
      esac
    done

    # Set defaults if not provided
    IMAGE_PREFIX=${IMAGE_PREFIX:-$DEFAULT_IMAGE_PREFIX}
    IMAGE_NAMESPACE=${IMAGE_NAMESPACE:-$DEFAULT_IMAGE_NAMESPACE}
    PATCH_VERSION=${PATCH_VERSION:-$DEFAULT_PATCH_VERSION}

    # Display configuration
    echo "=========================================="
    echo "Configuration:"
    echo "=========================================="
    if [ "$IMAGE_PREFIX" = "$DEFAULT_IMAGE_PREFIX" ]; then
      echo "Image Prefix: ${IMAGE_PREFIX} (default)"
    else
      echo "Image Prefix: ${IMAGE_PREFIX}"
    fi

    if [ "$IMAGE_NAMESPACE" = "$DEFAULT_IMAGE_NAMESPACE" ]; then
      echo "Image Namespace: ${IMAGE_NAMESPACE} (default)"
    else
      echo "Image Namespace: ${IMAGE_NAMESPACE}"
    fi

    if [ "$PATCH_VERSION" = "$DEFAULT_PATCH_VERSION" ]; then
      echo "Patch Version: ${PATCH_VERSION} (default)"
    else
      echo "Patch Version: ${PATCH_VERSION}"
    fi
    echo "=========================================="
    echo ""
    echo "Press any key to continue or Ctrl+C to cancel..."
    read -n 1 -s
    echo ""

    # Validate required environment variable
    if [ -z "$PROJECT_CPD_INST_OPERATORS" ]; then
      echo "Error: PROJECT_CPD_INST_OPERATORS environment variable must be set"
      exit 1
    fi

    # Check if digest pinning is needed
    if [ "$PATCH_VERSION" -ge 4 ]; then
      echo "Patch version ${PATCH_VERSION} detected - no digest pinning needed"
      exit 0
    fi

    # Digest mapping based on patch version
    declare -A DIGEST_MAP=(
      [0]="6493afc539d6a605da0d717268c048af56ca0c63dba2f65f0501ce0bb241be44"  # 5.3.1-no-patch
      [1]="087d37d0d4abc8903ea80c2f0b2677d85ad6f4a8b098e7c774a6bb1e1497ad99"  # 5.3.1-patch1
      [2]="f3e0a4dfedfa68da945ce891647a4d7404e5dea465f7ca34643ffcd438079066"  # 5.3.1-patch2
      [3]="f3e0a4dfedfa68da945ce891647a4d7404e5dea465f7ca34643ffcd438079066"  # 5.3.1-patch3
    )

    # Get digest for current patch version
    DIGEST=${DIGEST_MAP[$PATCH_VERSION]}

    if [ -z "$DIGEST" ]; then
      echo "Error: No digest found for PATCH_VERSION=${PATCH_VERSION}"
      exit 1
    fi

    # Construct full image name
    SPP_CPDBR_IMAGE_NAME="cpdbr-oadp@sha256:${DIGEST}"
    FULL_IMAGE_NAME="${IMAGE_PREFIX}${IMAGE_NAMESPACE}/${SPP_CPDBR_IMAGE_NAME}"

    # Display patch information and confirm
    echo "=========================================="
    echo "Patch Details:"
    echo "=========================================="
    echo "Will patch cpdbr-tenant-service with image:"
    echo "${FULL_IMAGE_NAME}"
    echo "=========================================="
    echo ""
    echo "Press any key to apply the patch or Ctrl+C to cancel..."
    read -n 1 -s
    echo ""

    # Apply the patch
    echo "Applying patch..."
    oc patch deploy cpdbr-tenant-service \
      --type json \
      -p "[{\"op\": \"replace\", \"path\": \"/spec/template/spec/containers/0/image\", \"value\": \"${FULL_IMAGE_NAME}\"}]"

    if [ $? -eq 0 ]; then
      echo ""
      echo "✓ Successfully patched cpdbr-tenant-service deployment"
    else
      echo ""
      echo "✗ Error: Failed to patch cpdbr-tenant-service deployment"
      exit 1
    fi

