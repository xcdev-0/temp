#!/usr/bin/env bash
# 사용자 제공 5.1.x OADP 설치 문서 §2의 이미지 5개만 조회한다.
# 원문: https://www.ibm.com/docs/en/software-hub/5.1.x?topic=software-installing-configuring-oadp-utility
set -uo pipefail

registry="${1:-${PRIVATE_REGISTRY_LOCATION:-}}"
registry="${registry%/}"
if [[ -z "$registry" || "$registry" == *://* ]]; then
  echo '사용: bash check-oadp-images-513.sh registry.example.com:5000'
  echo '레지스트리 주소에는 https:// 또는 docker://를 붙이지 마세요.'
  exit 2
fi
if ! command -v skopeo >/dev/null 2>&1; then
  echo '[중단] skopeo가 필요합니다.'
  exit 2
fi
tls_verify="${BR_TLS_VERIFY:-true}"
if [[ "$tls_verify" != true && "$tls_verify" != false ]]; then
  echo '[중단] BR_TLS_VERIFY에는 true 또는 false를 지정하세요.'
  exit 2
fi

images=(
  'cpopen/cpd/cpdbr-velero-plugin:5.1.3'
  'cpopen/cpd/cpdbr-oadp:5.1.3'
  'cpopen/cpd/cpdbr-api:5.1.3'
  'openshift4/ose-cli:latest'
  'ubi9/ubi-minimal:latest'
)

printf '사설 레지스트리: %s\n' "$registry"
echo '5.1.3 OADP 문서의 이미지 5개 조회 (cpdbr-api는 REST API 사용 시 필요)'
found=0
failed=0
for name in "${images[@]}"; do
  reference="$registry/$name"
  printf '\n조회: %s\n' "$reference"
  if result=$(skopeo inspect --tls-verify="$tls_verify" \
    --format '{{.Digest}}' "docker://$reference" 2>&1); then
    if [[ "$result" == *sha256:* || "$result" == *sha512:* ]]; then
      printf '[있음] %s\n' "$result"
      found=$((found + 1))
    else
      printf '[확인 필요] digest를 확인하지 못했습니다: %s\n' "$result"
      failed=$((failed + 1))
    fi
  else
    printf '[조회 실패] %s\n' "$result"
    failed=$((failed + 1))
  fi
done

printf '\n결과: manifest 확인 %s/5, 조회 실패 또는 확인 필요 %s/5\n' "$found" "$failed"
if (( failed > 0 )); then
  echo 'manifest unknown: 해당 경로/태그를 찾지 못함. 다른 태그가 있는지는 별도 확인 필요.'
  echo 'unauthorized/x509/접속 오류: 접근 문제이므로 이미지 누락으로 판단하지 마세요.'
  exit 1
fi
echo '조회한 5개 태그의 manifest가 모두 확인됐습니다.'
