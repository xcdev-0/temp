NS=ibm-cpd
J=jobs-retention-check-cronjob-29777830
P=$(oc get pod -n $NS -l job-name=$J -o jsonpath='{.items[0].metadata.name}')

echo
echo "=========================================="
echo "1. wdp-couchdb Service 존재 확인"
echo "=========================================="

oc get svc wdp-couchdb-svc -n $NS -o wide 2>&1

echo
echo "=========================================="
echo "2. CouchDB 관련 Service 전체"
echo "=========================================="

oc get svc -n $NS | grep -Ei 'couch|catalog|postgres|ccs-jobs' || true

echo
echo "=========================================="
echo "3. CouchDB 관련 Pod / StatefulSet / Deploy"
echo "=========================================="

oc get pod -n $NS -o wide | grep -Ei 'wdp-couch|couchdb' || true

oc get sts -n $NS | grep -Ei 'wdp-couch|couchdb' || true

oc get deploy -n $NS | grep -Ei 'wdp-couch|couchdb' || true

echo
echo "=========================================="
echo "4. Service Endpoint 확인"
echo "=========================================="

oc get endpoints wdp-couchdb-svc -n $NS -o wide 2>&1

echo
echo "=========================================="
echo "5. EndpointSlice 확인"
echo "=========================================="

oc get endpointslice -n $NS \
  -l kubernetes.io/service-name=wdp-couchdb-svc \
  -o wide 2>&1

echo
echo "=========================================="
echo "6. 현재 stuck Pod 내부에서 DNS 확인"
echo "=========================================="

oc exec -n $NS $P -- sh -c '
echo "### getent ###"
getent hosts wdp-couchdb-svc.ibm-cpd.svc.cluster.local 2>&1 || true

echo
echo "### /etc/resolv.conf ###"
cat /etc/resolv.conf
'

echo
echo "=========================================="
echo "7. POSTGRES_URI 존재 여부 (값 출력 안 함)"
echo "=========================================="

oc exec -n $NS $P -- sh -c '
if [ -n "${POSTGRES_URI:-}" ]; then
    echo "POSTGRES_URI=SET"
else
    echo "POSTGRES_URI=NOT_SET"
fi
'

echo
echo "=========================================="
echo "8. ccs-jobs-postgres Secret 존재 확인"
echo "   값은 절대 출력하지 않고 KEY 이름만 출력"
echo "=========================================="

if oc get secret ccs-jobs-postgres-edb-secret \
    -n $NS >/dev/null 2>&1; then

    echo "SECRET=EXISTS"

    oc get secret ccs-jobs-postgres-edb-secret \
      -n $NS -o json |
      jq -r '.data | keys[]'
else
    echo "SECRET=NOT_FOUND"
fi

echo
echo "=========================================="
echo "9. 현재 catalog-api 상태"
echo "=========================================="

oc get deploy,pod,svc -n $NS |
grep -Ei 'catalog-api|wdp-couch|ccs-jobs-postgres' || true

echo
echo "=========================================="
echo "10. CronJob / stuck Job 최종 확인"
echo "=========================================="

oc get cronjob jobs-retention-check-cronjob -n $NS

oc get job $J -n $NS \
  -o custom-columns='NAME:.metadata.name,ACTIVE:.status.active,SUCCEEDED:.status.succeeded,FAILED:.status.failed,START:.status.startTime'

oc get pod $P -n $NS -o wide
