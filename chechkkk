echo "===== Job 확인 ====="
oc get job -n ibm-cpd | grep jobs-retention-check || true

echo "===== Pod 확인 ====="
oc get pod -n ibm-cpd | grep jobs-retention-check || true

echo "===== CronJob 확인 ====="
oc get cronjob jobs-retention-check-cronjob -n ibm-cpd

echo "===== 현재 Active Job ====="
oc get jobs -n ibm-cpd -o json | jq -r '
.items[]
| select((.status.active // 0) > 0)
| [
    .metadata.name,
    ((.metadata.ownerReferences // []) | map(.name) | join(",")),
    (.status.active // 0),
    (.status.startTime // "-")
  ]
| @tsv
'
